# Copy to `.env` for local runs (do not commit `.env`).
# OpenEMR origin — agent calls GET {OPENEMR_BASE_URL}/api/user for session validation.
OPENEMR_BASE_URL=https://clinical-copilot-v2.fly.dev

# Optional gated live E2E (`agent/tests/integration/test_live_openemr_optional.py`):
#   RUN_LIVE_OPENEMR_E2E=1
#   OPENEMR_BASE_URL=...   (default above)
# For valid-session assertion only — use ONE of (never commit real values):
#   OPENEMR_AUTHORIZATION=Bearer <token>   # full Authorization header value
#   OPENEMR_BEARER_TOKEN=<token>           # raw token; tests send Bearer prefix if missing
# Optional deployed FastAPI agent smoke (POST /agent/chat via httpx):
#   AGENT_BASE_URL=https://...
# Alias: RUN_LIVE_OPENEMR_TESTS=1 still enables the same gate.
