# Copy to `.env` for local runs (do not commit `.env`).
# OpenEMR origin — agent calls GET {OPENEMR_BASE_URL}/api/user for session validation.
OPENEMR_BASE_URL=https://clinical-copilot-v2.fly.dev

# Optional: run `pytest agent/tests` live network test against OPENEMR_BASE_URL (invalid token must be rejected).
# RUN_LIVE_OPENEMR_TESTS=1
