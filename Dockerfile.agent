# Minimal production image for the Clinical Co-Pilot FastAPI agent (scaffold).
# Build context: repository root. Deploy: fly deploy --config fly.agent.toml
#
# Uvicorn loads create_app() as a factory; PYTHONPATH must include the repo root
# so the top-level `agent` package resolves.

FROM python:3.12-slim

# Override at build: docker build -f Dockerfile.agent --build-arg IMAGE_SOURCE_URL=https://your.git/host/repo .
ARG IMAGE_SOURCE_URL=https://example.com/replace-with-canonical-repo-url
LABEL org.opencontainers.image.title="Clinical Co-Pilot FastAPI agent" \
    org.opencontainers.image.description="Minimal production image for the Clinical Co-Pilot FastAPI agent (scaffold); Uvicorn loads create_app() with PYTHONPATH=/app." \
    org.opencontainers.image.source="${IMAGE_SOURCE_URL}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY deploy/requirements-agent.txt /app/deploy/requirements-agent.txt
RUN pip install --no-cache-dir -r /app/deploy/requirements-agent.txt

COPY agent /app/agent

# Synthea-style CSV cohort for AGENT_LLM_CSV_TOOLS (same paths as local pytest).
COPY fixtures/sample-patients /app/fixtures/sample-patients

RUN useradd --create-home --system --uid 10001 appuser \
    && chown -R appuser:appuser /app
USER appuser

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV FIXTURE_PATIENT_CSV_DIR=/app/fixtures/sample-patients

EXPOSE 8080

# Optional local/orchestrator health; Fly uses http_service.checks in fly.agent.toml.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/agent/health || exit 1

CMD ["uvicorn", "agent.http.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080"]
