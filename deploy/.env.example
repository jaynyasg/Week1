# .env.example — copy to .env and fill in real values. NEVER commit .env.
#
# Generate strong values with:
#   openssl rand -hex 24
#
# In production these live in Fly secrets (`fly secrets set ...`), not in .env.
# This file exists for two reasons:
#   1. Local docker-compose.prod.yml needs them as host-side env vars.
#   2. Documents every secret the project requires in one place.

# ── MariaDB ─────────────────────────────────────────────────────────────────
MYSQL_DATABASE=openemr
MYSQL_USER=openemr
MYSQL_PASSWORD=replace-with-openssl-rand-hex-24
MYSQL_ROOT_PASSWORD=replace-with-openssl-rand-hex-24

# ── OpenEMR initial admin (created by auto-installer on first boot) ─────────
OE_USER=admin
OE_PASS=replace-with-openssl-rand-hex-16

# ── Fly.io ──────────────────────────────────────────────────────────────────
# Public URL of the deployed OpenEMR app. Used by smoke tests.
DEPLOYED_URL=https://clinical-copilot-v2.fly.dev

# Base URL for the agent service to call OpenEMR REST `/api/user` (no trailing path).
# Used by `agent.http.deps.resolve_agent_role` when running the FastAPI agent locally or in CI.
OPENEMR_BASE_URL=https://clinical-copilot-v2.fly.dev

# Optional local/CI gated live E2E — see root `.env.example` and module docstring:
#   agent/tests/integration/test_live_openemr_optional.py
# Never commit tokens.
# RUN_LIVE_OPENEMR_E2E=1
# OPENEMR_AUTHORIZATION=Bearer ...
# OPENEMR_BEARER_TOKEN=...
# Optional deployed-agent chat smoke (POST /agent/chat); same gate + OpenEMR auth as root `.env.example`:
# AGENT_BASE_URL=https://...

# ── Future: Agent microservice (PR-06+) ─────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
