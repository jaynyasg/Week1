# Dockerfile.fly — optional override of the base openemr/openemr image.
#
# The default fly.toml uses `image = "openemr/openemr:7.0.2"` directly,
# which is the simplest path. Use this Dockerfile ONLY if you need to:
#   - Bake in custom OpenEMR modules (e.g., the future copilot_panel.php from PR-10)
#   - Add PHP extensions or system packages OpenEMR doesn't ship with
#   - Pre-load demo data into the image (not recommended — use a seed script instead)
#
# To use this Dockerfile instead of the registry image:
#   1. Replace the `[build]` block in fly.toml with:
#         [build]
#           dockerfile = "Dockerfile.fly"
#   2. Run `fly deploy --config fly.toml` — Fly will build remotely on its builders.

FROM openemr/openemr:7.0.2

# Use a file-based wrapper so the startup patch is preserved in the final image.
COPY deploy/openemr_wrapper.sh /openemr_wrapper.sh
RUN chmod +x /openemr_wrapper.sh
ENTRYPOINT ["/openemr_wrapper.sh"]

# Default CMD/ENTRYPOINT inherited from the base image — do not override unless
# you understand the OpenEMR auto-installer flow.