# OpenEMR Fly image + Clinical Co-Pilot static UI + Apache /agent reverse proxy.
#
# Build context: repository root (see root fly.toml [build] dockerfile = "deploy/Dockerfile.fly").
#
# The React app is served at /interface/copilot/ on the OpenEMR hostname. POST /agent/*
# is proxied to the FastAPI agent on Fly 6PN (default clinical-agent-scaffold.internal:8080).
# Override with fly.toml [env] CLINICAL_AGENT_INTERNAL_URL.

# --- Stage 1: Vite production build (embedded paths)
FROM node:20-alpine AS copilot_ui
WORKDIR /ui
COPY chat-ui/package.json chat-ui/package-lock.json ./
RUN npm install
COPY chat-ui/ ./

ARG VITE_BASE_PATH=/interface/copilot/
ARG VITE_EMBEDDED=true
ENV VITE_BASE_PATH=${VITE_BASE_PATH}
ENV VITE_EMBEDDED=${VITE_EMBEDDED}
ENV VITE_AGENT_BASE_URL=

RUN npm run build

# --- Stage 2: OpenEMR base
FROM openemr/openemr:7.0.2

# Install Apache mod_proxy — the base OpenEMR Alpine image ships only core modules.
# apache2-proxy provides mod_proxy.so and mod_proxy_http.so needed for /agent proxying.
RUN apk add --no-cache apache2-proxy

COPY deploy/enable-apache-proxy-modules.sh /tmp/enable-apache-proxy-modules.sh
RUN sed -i 's/\r$//' /tmp/enable-apache-proxy-modules.sh \
    && sh /tmp/enable-apache-proxy-modules.sh \
    && rm -f /tmp/enable-apache-proxy-modules.sh

COPY deploy/openemr_wrapper.sh /openemr_wrapper.sh
RUN sed -i 's/\r$//' /openemr_wrapper.sh && chmod +x /openemr_wrapper.sh
ENTRYPOINT ["/openemr_wrapper.sh"]

COPY --from=copilot_ui /ui/dist /var/www/localhost/htdocs/openemr/interface/copilot
RUN chown -R apache:root /var/www/localhost/htdocs/openemr/interface/copilot

# Inject AI Co-Pilot into the standard navigation menu (embedded path, same origin).
RUN sed -i 's/^]$/,{"label":"AI Co-Pilot","menu_id":"AIcoPilot","url":"\/interface\/copilot\/","target":"_blank","children":[],"requirement":0}]/' \
    /var/www/localhost/htdocs/openemr/interface/main/tabs/menu/menus/standard.json
